{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympozium.ai/schemas/celln-authorisation/credential-v1.json",
  "title": "CellnAuthorisationCredentialClaims",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "iss", "aud", "iat", "nbf", "exp", "jti",
    "decisionDigest", "budgetId", "operation", "subject"
  ],
  "properties": {
    "apiVersion": { "const": "celln.sympozium.ai/authorisation-credential-v1" },
    "iss": { "const": "sympozium-control-plane" },
    "aud": { "enum": ["celln-execution", "sympozium-model-gateway"] },
    "iat": { "type": "integer", "minimum": 1 },
    "nbf": { "type": "integer", "minimum": 1 },
    "exp": { "type": "integer", "minimum": 1 },
    "jti": { "type": "string", "minLength": 16, "maxLength": 128 },
    "decisionDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "budgetId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operation": {
      "enum": [
        "execution.start", "execution.turn", "execution.cancel", "execution.stop",
        "execution.read", "execution.cleanup", "model.invoke"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runUid", "turnId", "parentIncarnation"],
      "properties": {
        "runUid": { "type": "string", "minLength": 1, "maxLength": 253 },
        "turnId": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 64 }
          ]
        },
        "parentIncarnation": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" }
          ]
        }
      }
    }
  }
}
